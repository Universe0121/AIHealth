<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 页标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="诊断单识别"
            style="@style/TextAppearance.AIHealth.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="拍下诊断单，自动帮你读懂诊断结论与医嘱"
            style="@style/TextAppearance.AIHealth.Caption" />

        <!-- 图片预览 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            style="@style/Widget.AIHealth.Card">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_diagnosis"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="诊断单图片预览"
                    android:src="@drawable/ic_camera_guide" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="还没有照片\n点击下方按钮拍摄或上传"
                    android:textSize="16sp"
                    android:textColor="@color/on_surface_variant"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 拍照按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_take_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="拍照识别"
            app:icon="@drawable/ic_camera"
            app:iconSize="22dp"
            style="@style/Widget.AIHealth.Button" />

        <!-- 识别结果 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="识别结果"
            style="@style/TextAppearance.AIHealth.Title" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.AIHealth.Card">

            <TextView
                android:id="@+id/tv_ocr_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:padding="18dp"
                android:text="识别结果会显示在这里"
                android:textSize="17sp"
                android:textColor="@color/on_surface_variant"
                android:lineSpacingExtra="4dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 保存与统计 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="保存到我的记录"
            app:icon="@drawable/ic_save"
            app:iconSize="22dp"
            style="@style/Widget.AIHealth.Button.Tonal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quick_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="快速统计"
                style="@style/Widget.AIHealth.Button.Outlined" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_charts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="查看图表"
                style="@style/Widget.AIHealth.Button.Outlined" />
        </LinearLayout>

        <!-- 历史记录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="历史记录"
                style="@style/TextAppearance.AIHealth.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="筛选"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:icon="@drawable/ic_history"
                style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty_history"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="还没有记录\n拍下第一张诊断单吧"
            android:textSize="16sp"
            android:textColor="@color/on_surface_variant"
            android:lineSpacingExtra="4dp"
            android:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
