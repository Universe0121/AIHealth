<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- 新增：返回按钮 + 标题 横向布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">
        <!-- 返回主页面按钮 -->
        <Button
            android:id="@+id/btn_back_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回主页面"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:layout_marginRight="20dp"/>
        <!-- 页面标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="药品全周期管理"
            android:textSize="24sp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- 原有控件：药品名称、剂量等（不变） -->
    <EditText
        android:id="@+id/et_drug_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入药品名称（如：感冒药）"
        android:padding="10dp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/et_dosage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入用药剂量（如：每天1次，每次1片）"
        android:padding="10dp"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服用频率："
            android:textSize="16sp"
            android:layout_gravity="center_vertical"/>
        <Spinner
            android:id="@+id/sp_take_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/take_frequency"/>
    </LinearLayout>

    <EditText
        android:id="@+id/et_cycle_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入服用周期（如：7天）"
        android:padding="10dp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/et_take_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入服用时间（如：早8点）"
        android:padding="10dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_save_drug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存药品信息"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_set_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置用药提醒"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btn_view_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="查看用药历史"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"/>

</LinearLayout>