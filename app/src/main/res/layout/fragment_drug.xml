<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 页标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="药品管理"
            style="@style/TextAppearance.AIHealth.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="记下服药计划，按时提醒你吃药"
            style="@style/TextAppearance.AIHealth.Caption" />

        <!-- 拍照识别 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_drug_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="拍照识别药品"
            app:icon="@drawable/ic_camera"
            app:iconSize="22dp"
            style="@style/Widget.AIHealth.Button" />

        <!-- 录入表单 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Widget.AIHealth.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加药品"
                    style="@style/TextAppearance.AIHealth.Title"
                    android:layout_marginBottom="18dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="药品名称"
                    style="@style/Widget.AIHealth.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_drug_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        style="@style/Widget.AIHealth.TextInputEditText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="每天吃几次"
                    style="@style/Widget.AIHealth.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_take_times"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        style="@style/Widget.AIHealth.TextInputEditText" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_take_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="设置吃药时间"
                    app:icon="@drawable/ic_info"
                    style="@style/Widget.AIHealth.Button.Outlined"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="服药状态"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rg_take_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_not_taken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="还没吃"
                        android:textSize="16sp"
                        android:checked="true" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rb_taken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="已吃完"
                        android:textSize="16sp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_drug"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="保存药品"
                        style="@style/Widget.AIHealth.Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="清空"
                        style="@style/Widget.AIHealth.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 药品列表 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="我的药品"
                style="@style/TextAppearance.AIHealth.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="批量编辑"
                android:textSize="15sp"
                android:textAllCaps="false"
                style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_usage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="改次数"
                android:visibility="gone"
                style="@style/Widget.AIHealth.Button.Tonal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_batch_reminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="管提醒"
                android:visibility="gone"
                style="@style/Widget.AIHealth.Button.Tonal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_empty_drugs"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="还没有药品记录\n在上方添加或拍照识别"
            android:textSize="16sp"
            android:textColor="@color/on_surface_variant"
            android:lineSpacingExtra="4dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_drug_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
