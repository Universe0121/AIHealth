<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- 新增：返回按钮 + 标题 横向布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">
        <!-- 返回主页面按钮 -->
        <Button
            android:id="@+id/btn_back_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="返回主页面"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:layout_marginRight="20dp"/>
        <!-- 页面标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运动个性化指导"
            android:textSize="24sp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- 原有控件：运动类型、强度等（不变） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运动类型："
            android:textSize="16sp"
            android:layout_gravity="center_vertical"/>
        <Spinner
            android:id="@+id/sp_sport_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/sport_type"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运动强度："
            android:textSize="16sp"
            android:layout_gravity="center_vertical"/>
        <Spinner
            android:id="@+id/sp_intensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/intensity_level"/>
    </LinearLayout>

    <EditText
        android:id="@+id/et_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入运动时长（分钟）"
        android:inputType="number"
        android:padding="10dp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/et_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="请输入运动目标（如：减脂/增肌/健身）"
        android:padding="10dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btn_generate_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="生成个性化指导"
        android:backgroundTint="#E91E63"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tv_guide_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone"/>

</LinearLayout>