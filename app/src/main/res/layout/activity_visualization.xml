<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- 页标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="健康数据可视化"
            style="@style/TextAppearance.AIHealth.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="数据趋势、健康评分与统计报告"
            style="@style/TextAppearance.AIHealth.Caption" />

        <!-- 健康评分卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            style="@style/Widget.AIHealth.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="健康综合评分"
                    style="@style/TextAppearance.AIHealth.Title"
                    android:layout_marginBottom="16dp" />

                <com.aihealth.ui.widget.HealthScoreView
                    android:id="@+id/health_score_view"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/tv_score_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="根据您的血压、血糖、用药依从性等数据计算得出"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_score_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="查看评分详情"
                    style="@style/Widget.AIHealth.Button.Outlined" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 血压趋势卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.AIHealth.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="血压趋势图"
                        style="@style/TextAppearance.AIHealth.Title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_bp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="刷新"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_refresh"
                        style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>

                <com.aihealth.ui.widget.SimpleLineChart
                    android:id="@+id/bp_chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="最近7天收缩压变化趋势"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 血糖趋势卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.AIHealth.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="血糖趋势图"
                    style="@style/TextAppearance.AIHealth.Title"
                    android:layout_marginBottom="14dp" />

                <com.aihealth.ui.widget.SimpleBarChart
                    android:id="@+id/bs_chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="最近7天空腹血糖变化"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_bs_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="状态：控制良好"
                        android:textColor="@color/success"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 统计报告卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/Widget.AIHealth.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="统计报告"
                    style="@style/TextAppearance.AIHealth.Title"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_weekly_report"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="周报告"
                        app:icon="@drawable/ic_week"
                        style="@style/Widget.AIHealth.Button.Outlined" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_monthly_report"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="月报告"
                        app:icon="@drawable/ic_month"
                        style="@style/Widget.AIHealth.Button.Outlined" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_export_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="导出数据"
                    app:icon="@drawable/ic_save"
                    style="@style/Widget.AIHealth.Button.Tonal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="生成周/月健康统计报告，可导出为文本文件"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 返回按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="返回主页"
            app:icon="@drawable/ic_arrow_back"
            style="@style/Widget.AIHealth.Button.Outlined" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
